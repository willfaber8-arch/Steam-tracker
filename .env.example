# Steam Web API — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Your 17-digit SteamID64 — look it up at https://steamid.io or similar
STEAM_ID64=

# Postgres connection string. If you provision Vercel Postgres or Supabase
# and link it to this project, this (and the related POSTGRES_* vars) is
# populated automatically — copy it into .env.local for local development.
POSTGRES_URL=

# Optional: set this and Vercel Cron will send it as a Bearer token so the
# snapshot endpoint can verify requests actually came from Vercel Cron.
CRON_SECRET=
